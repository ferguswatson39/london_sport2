from prepare_boroughs import prepare_borough_data
from sklearn.linear_model import LinearRegression
from scipy.special import logit, expit
import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

def logistic_forecast_borough(included_years : list, forecast_years: list, target_col: str, ADJUST_COVID: bool) -> pd.DataFrame:
    borough_df = prepare_borough_data(ADJUST_COVID = ADJUST_COVID, target_col = target_col)
    borough_df = borough_df[borough_df['year'].isin(included_years)]
    borough_df[target_col] = borough_df.groupby('LA_Name')[target_col].ffill()
    output = []
    for borough in borough_df['LA_Name'].unique():
        X_train = (np.array(included_years) - 2017).reshape(-1, 1)
        X_forecast = (np.array(forecast_years) - 2017).reshape(-1, 1)
        X_full = np.concat((X_train, X_forecast))
        Y_train = borough_df[borough_df['LA_Name'] == borough][target_col].values
        MIN, MAX, HISTORICAL_RANGE = Y_train.min(), Y_train.max(), Y_train.max() - Y_train.min()
        BUFFER = max(0.1, HISTORICAL_RANGE)
        LOWER_BOUND, UPPER_BOUND = max(0, MIN - BUFFER), min(1.0, MAX + BUFFER)
        SCALE = UPPER_BOUND - LOWER_BOUND
        Y_train_scaled = (Y_train - LOWER_BOUND) / SCALE
        Y_train_logit = logit(Y_train_scaled)
        model = LinearRegression()
        model.fit(X_train, Y_train_logit)
        Y_forecast = (LOWER_BOUND + (expit(model.predict(X_forecast)) * SCALE)) * 100
        Y_predicted = (LOWER_BOUND + (expit(model.predict(X_full)) * SCALE)) * 100
        Y_observed = np.concat((Y_train * 100, Y_forecast))
        for year, observed, predicted in zip(included_years + forecast_years, Y_observed, Y_predicted):
            output.append({'borough': borough, 'year' : year, 'observed' : observed, 'predicted' : predicted})
    return pd.DataFrame(output)

# Forecast Visualisation
if __name__ == "__main__":
    INCLUDED_YEARS =  [2017, 2018, 2019, 2020, 2021, 2022, 2023]
    FORECAST_YEARS = [2024, 2025, 2026, 2027, 2028, 2029]
    ADJUST_COVID = True
    TARGET_COL = 'active'
    full_df = logistic_forecast_borough(INCLUDED_YEARS, FORECAST_YEARS, target_col = TARGET_COL, ADJUST_COVID = ADJUST_COVID)
    colours = ['#808080'] * len(INCLUDED_YEARS) + ['#00BFFF'] * len(FORECAST_YEARS)
    g = sns.relplot(kind = 'scatter', 
                    data = full_df, 
                    x = 'year', 
                    y = 'observed', 
                    col = 'borough', 
                    col_wrap = 8,
                    height = 2, 
                    aspect = 1.4,
                    s = 50,
                    palette = 'RdYlGn',
                    hue = 'observed',
                    legend = False,
                    edgecolors = colours, 
                    linewidth = 1,
                    zorder = 2)
    
    for borough, ax in g.axes_dict.items():
        borough_df = full_df[full_df['borough'] == borough]
        # Add regression line
        sns.lineplot(data = borough_df, 
                    x = 'year', 
                    y = 'predicted',
                    ax = ax,
                    color = '#00BFFF',
                    alpha = 0.3, 
                    zorder = 0)
        
    g.set_titles('{col_name}', weight = 'bold')
    g.set(xlabel = 'Year', ylabel = '% Active')
    g.set_xticklabels([])
    if ADJUST_COVID:
        plt.savefig(f'src/stream_1/figures/Logistic Borough Forecast - {TARGET_COL} (COVID Adjusted)', bbox_inches = 'tight')
    else:
        plt.savefig(f'src/stream_1/figures/Logistic Borough Forecast {TARGET_COL}', bbox_inches = 'tight')
    plt.show()
